# Retailer Studio web app (embedded in the Shopify admin). Copy to .env.local.
# Only NEXT_PUBLIC_* values reach the browser; never put secrets here. The Shopify client secret stays in the backend.

# The app's client id from the Shopify Dev Dashboard (public, App Bridge needs it).
NEXT_PUBLIC_SHOPIFY_API_KEY=

# Backend base URL, server side only. /api/v1, /auth/shopify and /webhooks/shopify are forwarded to it.
BACKEND_URL=http://localhost:3000

# 1 = no Shopify admin and no backend: fake App Bridge, a plain dev frame and in-memory fixtures.
NEXT_PUBLIC_MOCK=1

# Polaris web components build. polaris-1.js is the classic admin look; polaris-2.0-rc.js is the new look.
NEXT_PUBLIC_POLARIS_URL=https://cdn.shopify.com/shopifycloud/polaris-1.js
