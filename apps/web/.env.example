# Retailer Studio web app (embedded in the Shopify admin). Copy to .env.local for development.
# Everything here is read at RUNTIME, so one built image works for any deployment. Only the client id is public;
# never put the Shopify client secret here (it stays in the backend).

# The app's client id from the Shopify Dev Dashboard (public, App Bridge needs it in the page).
SHOPIFY_API_KEY=

# Backend origin, server side only. /api/v1, /auth/shopify/* and /webhooks/shopify are forwarded to it.
# Use the internal address when the backend runs next to the web app, for example http://backend:3000.
BACKEND_URL=http://localhost:3000

# Polaris web components build. polaris-1.js is the classic admin look; polaris-2.0-rc.js is the new look.
POLARIS_URL=https://cdn.shopify.com/shopifycloud/polaris-1.js

# Development only: 1 = no Shopify admin and no backend (fake App Bridge, a plain dev frame, in-memory fixtures).
# This one is inlined when the app is BUILT, so set it before `pnpm -F @rs/web build`.
NEXT_PUBLIC_MOCK=
