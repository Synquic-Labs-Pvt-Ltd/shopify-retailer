{
  "name": "@rs/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retailer Studio backend: Express 5 modular monolith (api, worker or both).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke-providers.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@rs/shared": "workspace:*",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mongoose": "9.11.0",
    "pino": "10.4.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
