# Retailer Studio backend environment (SPEC 19). Copy to .env. Empty values count as unset.
# Everything below has a development default except where noted; production refuses the dev defaults.

NODE_ENV=development
PORT=3000
# api, worker or all
ROLE=all
# https in production (the cloudflared tunnel URL in Phase 3)
PUBLIC_BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/retailer-studio

# Required in production. Generate each with: openssl rand -hex 32
JWT_SECRET=
# 32 bytes as 64 hex characters or base64
TOKEN_ENC_KEY=

# Required in production (Shopify Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_files,write_files
SHOPIFY_API_VERSION=2026-10
APP_DEEP_LINK_SCHEME=retailerstudio

# Vertex AI (default provider)
GOOGLE_CLOUD_PROJECT=
# Path to the service-account JSON with the Vertex AI User role. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for hosts that only take env vars: the whole service-account key JSON, raw or base64 (single line).
# Takes precedence over GOOGLE_APPLICATION_CREDENTIALS and also supplies the project id when GOOGLE_CLOUD_PROJECT is unset.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Only for the aistudio provider
GEMINI_API_KEY=

# Optional override of config/generation.config.json
GENERATION_CONFIG_PATH=
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
