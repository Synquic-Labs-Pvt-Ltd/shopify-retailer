# Retailer Studio mobile environment. Copy to .env. Only EXPO_PUBLIC_* values reach the app; never put secrets here.

# Backend base URL without a trailing slash. Android emulator: http://10.0.2.2:3000. Physical device: your LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# true serves the in-memory fixtures from src/api/mock.ts and needs no backend.
EXPO_PUBLIC_API_MOCK=true
